# Patient data: never commit it. The pre-commit hook (.githooks/pre-commit)
# runs the Suite's tools/check_project.py [5b], which also reads the content,
# for DICOM without an extension.
*.[dD][cC][mM]
*.[dD][iI][cC][oO][mM]
*.[nN][iI][iI]
*.[nN][iI][iI].[gG][zZ]
*.[nN][rR][rR][dD]
*.[nN][hH][dD][rR]
*.[mM][hH][aA]
*.[mM][hH][dD]
*.[rR][aA][wW]
*.[rR][aA][wW].[gG][zZ]
*.[zZ][rR][aA][wW]
*.[hH][dD][rR]
*.[iI][mM][gG]
*.[iI][mM][gG].[gG][zZ]
*.[mM][gG][zZ]
